<div class="page-header">

  <% if(theme.breadcrumb && theme.breadcrumb.isShow == true) { %>
    <div class="breadcrumb">
      <div class="location"><%= location %></div>
      <i class="icon-location"></i>
    </div>
  <% } %>

  <%- partial('toolbox') %>

  <div class="box-blog-info">
    <a class="avatar" href="/">
      <img src="<%= theme.avatar %>" alt="" />
    </a>
    <div class="info">
      <h3 class="name" style="font-family: <%= theme.blog_name_font_familiy || 'calligraffittiregular' %>">
        <%= theme.blog_name %>
      </h3>
      <div class="slogan">
        <div id="app">
          <span id="ityped"></span>
        </div>
      </div>
      <script>
        ityped.init(document.querySelector("#ityped"), {
            showCursor: true,
            strings: ['<%=theme.slogan%>','<%=theme.slogan2%>'],
            typeSpeed:  100,
            backSpeed:  50,
            startDelay: 500,
            backDelay:  3000,
            
          })
        
          </script>
    </div>
  </div>

</div>
