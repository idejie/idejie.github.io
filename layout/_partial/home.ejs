<div class="content-home text-center">
  <a class="avatar" href="/">
    <img src="<%= theme.avatar %>" alt="" />
  </a>
  <h1 class="name" style="font-family: <%= theme.blog_name_font_familiy || 'calligraffittiregular' %>">
    <%= theme.blog_name %>
  </h1>


    <style>
      .ityped-cursor {
        font-size: 2.2rem;
        opacity: 1;
        -webkit-animation: blink 0.3s infinite;
        -moz-animation: blink 0.3s infinite;
        animation: blink 0.3s infinite;
        animation-direction: alternate;
      }
  
      @keyframes blink {
        100% {
          opacity: 0;
        }
      }
  
      @-webkit-keyframes blink {
        100% {
          opacity: 0;
        }
      }
  
      @-moz-keyframes blink {
        100% {
          opacity: 0;
        }
      }
    </style>
  <div class="slogan">
    <div id="app">
      <span id="ityped"></span>
    </div>
  </div>
  <script>
    ityped.init(document.querySelector("#ityped"), {
        showCursor: true,
        strings: ['<%=theme.slogan%>','<%=theme.slogan2%>'],
        typeSpeed:  100,
        backSpeed:  50,
        startDelay: 500,
        backDelay:  3000,
        
      })
    
      </script>
  <hr>

  <ul class="text-center nav">
    <% theme.home_nav.forEach(function(item, i){ %>
      <li class="item">
        <% if(item.target_blank === true) { %>
          <a href="<%= item.url %>" rel="noopener noreferrer" target="_blank"><%= item.name %></a>
        <% } else { %>
          <a href="<%= item.url %>"><%= item.name %></a>
        <% } %>
        <span>|</span>
      </li>
    <% }) %>
  </ul>
  <div>

            <span id="busuanzi_container_site_pv">本站总访问量：<span id="busuanzi_value_site_pv"></span>次</span>
            <br/>本站访问人数：<span id="busuanzi_value_site_uv"></span>人次
</div>
</div>
<script type="text/javascript" color="102,102,102" opacity='0.5' zIndex="-2" count="99"  src="//cdn.bootcss.com/canvas-nest.js/1.0.1/canvas-nest.min.js"></script>
